---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadge from '../components/TrustBadge.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('research'))
  .filter(p => p.data.status === 'Live')
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Home" description="Vendor-neutral analysis of security platforms, threat landscapes, and compliance frameworks — from zero-trust architecture to AI-powered defense.">

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero__orb hero__orb--1"></div>
    <div class="hero__orb hero__orb--2"></div>
    <div class="hero__orb hero__orb--3"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="hero__kicker"><span class="pulse-dot"></span> Cybersecurity Research &middot; Independent &middot; Evidence-Based</span>
        <h1 class="hero__title"><span class="gradient-text">Independent Cybersecurity</span> Intelligence You Can Trust</h1>
        <p class="hero__sub">Vendor-neutral analysis of security platforms, threat landscapes, and compliance frameworks — from zero-trust architecture to AI-powered defense.</p>
        <div class="hero__ctas">
          <a href="/insights" class="btn">Read Our Insights</a>
          <a href="/methodology" class="btn btn-outline" style="border-color:rgba(255,255,255,0.4);color:#fff;">Our Methodology</a>
        </div>
        <div class="hero__badges">
          <TrustBadge icon="&#10003;" label="No pay-to-rank" />
          <TrustBadge icon="&#128203;" label="Published methodology" />
          <TrustBadge icon="&#128100;" label="Named reviewers" />
          <TrustBadge icon="&#8634;" label="Open corrections" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SIGNAL BAR ═══ -->
  <div class="signal-bar">
    <div class="signal-bar__label"><span class="pulse-dot pulse-dot--green"></span> LIVE</div>
    <div class="signal-bar__track">
      <div class="signal-bar__content">
        <span class="signal-bar__item">Zero Trust Adoption: 58% of enterprises now have ZTNA deployment in production</span>
        <span class="signal-bar__item">AI-Powered Threats: Adversarial AI attacks up 340% in H1 2026</span>
        <span class="signal-bar__item">Cloud Security Market: $18.2B in 2026, CSPM segment growing fastest at 42% CAGR</span>
        <span class="signal-bar__item">Ransomware Economics: Average ransom payment reaches $1.4M, recovery costs $4.8M</span>
        <span class="signal-bar__item">Supply Chain Attacks: 23% increase in software supply chain compromises year-over-year</span>
        <span class="signal-bar__item">Quantum-Ready Cryptography: NIST standards adoption at 12% among F500 companies</span>
        <span class="signal-bar__item">Zero Trust Adoption: 58% of enterprises now have ZTNA deployment in production</span>
        <span class="signal-bar__item">AI-Powered Threats: Adversarial AI attacks up 340% in H1 2026</span>
        <span class="signal-bar__item">Cloud Security Market: $18.2B in 2026, CSPM segment growing fastest at 42% CAGR</span>
        <span class="signal-bar__item">Ransomware Economics: Average ransom payment reaches $1.4M, recovery costs $4.8M</span>
        <span class="signal-bar__item">Supply Chain Attacks: 23% increase in software supply chain compromises year-over-year</span>
        <span class="signal-bar__item">Quantum-Ready Cryptography: NIST standards adoption at 12% among F500 companies</span>
      </div>
    </div>
  </div>

  <!-- ═══ STATS ═══ -->
  <section class="section stats-section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-card__num">450+</span>
          <span class="stat-card__label">Vendor Evaluations</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">72</span>
          <span class="stat-card__label">Attack Vectors Mapped</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">99.2%</span>
          <span class="stat-card__label">Detection Accuracy</span>
        </div>
        <div class="stat-card">
          <span class="stat-card__num">38</span>
          <span class="stat-card__label">Compliance Frameworks</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FEATURED REPORT ═══ -->
  <section class="section section--dark">
    <div class="container report-spotlight">
      <div class="report-spotlight__info">
        <span class="report-spotlight__label">Featured Report</span>
        <h2>Enterprise Security Platform Consolidation 2026</h2>
        <p>Analysis of 28 security platform vendors evaluating detection efficacy, integration depth, automation capability, and total cost of ownership.</p>
        <div class="report-spotlight__meta">
          <span>Research Team</span><span>48 pages</span><span>24 vendors scored</span><span>Jul 2026</span>
        </div>
        <a href="/insights" class="btn">Read the Report</a>
      </div>
      <div class="report-spotlight__card">
        <div class="report-mockup">
          <span class="report-mockup__badge">Cybersecurity</span>
          <h3 class="report-mockup__title">Enterprise Security Platform Consolidation 2026</h3>
          <div class="report-mockup__divider"></div>
          <div class="report-mockup__bars">
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Detection Efficacy</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:87%"></div></div>
              <span class="report-mockup__bar-val">87%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Platform Integration</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:64%"></div></div>
              <span class="report-mockup__bar-val">64%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Automation Depth</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:73%"></div></div>
              <span class="report-mockup__bar-val">73%</span>
            </div>
            <div class="report-mockup__bar-row">
              <span class="report-mockup__bar-label">Cost Efficiency</span>
              <div class="report-mockup__bar-track"><div class="report-mockup__bar-fill" style="width:56%"></div></div>
              <span class="report-mockup__bar-val">56%</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ LATEST INSIGHTS ═══ -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <div>
          <span class="section__label">Latest Intelligence</span>
          <h2>Recent Cybersecurity Research</h2>
        </div>
        <a href="/insights" class="link-arrow">View all insights &rarr;</a>
      </div>
      {posts.length > 0 ? (
        <div class="insights-grid">
          {posts.map(post => (
            <article class="insight-card">
              <span class="insight-card__tag">{post.data.outputFormat || 'Report'}</span>
              <h3><a href={'/research/' + post.id}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <span class="insight-card__meta">{post.data.author} &middot; {new Date(post.data.publishDate).toLocaleDateString('en-US', { month:'short', year:'numeric' })}</span>
            </article>
          ))}
        </div>
      ) : (
        <div class="insights-grid">
          <article class="insight-card">
            <span class="insight-card__tag">Benchmark</span>
            <h3>SIEM/XDR Platform Comparison: Detection and Response Capabilities</h3>
            <span class="insight-card__meta">Jul 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Analysis</span>
            <h3>AI in Cybersecurity: Defensive AI vs Adversarial AI Arms Race</h3>
            <span class="insight-card__meta">Jun 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Primer</span>
            <h3>Zero Trust Architecture Implementation: A Practitioner's Framework</h3>
            <span class="insight-card__meta">Jun 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Report</span>
            <h3>Cloud-Native Security: CNAPP Platform Maturity Assessment</h3>
            <span class="insight-card__meta">May 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Benchmark</span>
            <h3>Identity & Access Management: Enterprise IAM Vendor Scorecard</h3>
            <span class="insight-card__meta">May 2026</span>
          </article>
          <article class="insight-card">
            <span class="insight-card__tag">Analysis</span>
            <h3>Quantum Computing Threat: Cryptographic Migration Readiness Report</h3>
            <span class="insight-card__meta">Apr 2026</span>
          </article>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ INSIGHTS FEED ═══ -->
  <section class="section section--soft">
    <div class="container">
      <span class="section__label">Market Commentary</span>
      <h2 style="margin-bottom:1.5rem;">Cybersecurity Insights Feed</h2>
      <div class="feed-list">
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Benchmark</span>
          <span class="feed-item__title">SIEM/XDR Platform Comparison: Detection and Response Capabilities</span>
          <span class="feed-item__date">Jul 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">AI in Cybersecurity: Defensive AI vs Adversarial AI Arms Race</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Primer</span>
          <span class="feed-item__title">Zero Trust Architecture Implementation: A Practitioner's Framework</span>
          <span class="feed-item__date">Jun 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Report</span>
          <span class="feed-item__title">Cloud-Native Security: CNAPP Platform Maturity Assessment</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Benchmark</span>
          <span class="feed-item__title">Identity & Access Management: Enterprise IAM Vendor Scorecard</span>
          <span class="feed-item__date">May 2026</span>
        </a>
        <a href="/insights" class="feed-item">
          <span class="feed-item__tag">Analysis</span>
          <span class="feed-item__title">Quantum Computing Threat: Cryptographic Migration Readiness Report</span>
          <span class="feed-item__date">Apr 2026</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ═══ -->
  <section class="section section--dark">
    <div class="container newsletter-section">
      <div class="newsletter-section__content">
        <h2>Get the <span class="gradient-text">Cybersecurity Briefing</span></h2>
        <p>Weekly research digest with key findings, market signals, and analysis — delivered to your inbox.</p>
        <div class="newsletter-section__proof">
          <span>2,400+ subscribers</span><span>82% open rate</span><span>Free forever</span>
        </div>
      </div>
      <div class="newsletter-section__form">
        <NewsletterSignup />
      </div>
    </div>
  </section>

</BaseLayout>
